          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (shipping) (increase(gfc_orders_paid_total{environment=\"$environment\"}[$__rate_interval]))",
          "legendFormat": "paid ({{shipping}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
