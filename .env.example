# Copy to .env (git-ignored) for local development, or set these as real
# environment variables on the server. Never commit real values.

# Database
DB_URL=jdbc:mysql://localhost:3306/guiltFreeCookie?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# Signs admin login tokens. Generate a fresh one per environment:
#   openssl rand -base64 32
JWT_SECRET=

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to true wherever the API is reachable over HTTPS
REQUIRE_HTTPS=false

# Links in emails point here
FRONTEND_BASE_URL=http://localhost:5173

# Email (off = emails are written to the log instead)
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Guilt Free Cookie <hello@guiltfreecookie.co.za>

# PayFast (defaults are the public sandbox test merchant)
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
# Where PayFast sends payment notifications. Locally, run: cloudflared tunnel --url http://localhost:8080
PAYFAST_NOTIFY_URL=

# Shipping defaults (editable later in admin)
SHIPPING_COURIER_RATE=80.00
SHIPPING_PUDO_RATE=60.00
SHIPPING_FREE_THRESHOLD=500.00
SHIPPING_PICKUP_ADDRESS=

# ---- Email flows (optional) ----
# Signs unsubscribe links; defaults to JWT_SECRET.
EMAIL_LINK_SECRET=
# false starts with every automated email flow switched off (admins can switch them on).
FLOWS_ENABLED=true

# ---- First admin (empty database only) ----
# Creates the first admin on startup; does nothing once any admin exists. Remove after first sign-in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
